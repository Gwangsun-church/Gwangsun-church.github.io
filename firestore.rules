rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ★ 관리자 구글 계정 (js/config.js 의 ADMIN_EMAILS 와 동일하게!)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['jehohw92@gmail.com'];
    }

    function signedIn() { return request.auth != null; }

    // 주보: 누구나 읽기, 쓰기/삭제는 관리자만
    match /bulletins/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 게시글: 누구나 읽기, 쓰기는 로그인한 본인 명의만,
    //         수정은 조회수(views)만 허용, 삭제는 본인 또는 관리자
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);

      // 댓글: 누구나 읽기, 쓰기는 로그인한 본인 명의만, 삭제는 본인 또는 관리자
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000;
        allow delete: if isAdmin() || (signedIn() && resource.data.authorUid == request.auth.uid);
      }
    }
  }
}
